# ==============================================================================
# Websoul Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Admin Authentication (Vercel Serverless Functions & Vite Dev Server)
# Generate a secure scrypt password hash using: npm run hash-password <your-password>
# Option 1: Multi-admin JSON array with hashed passwords (recommended)
ADMIN_USERS=[{"email":"admin@websoul.tech","passwordHash":"scrypt:your_salt_here:your_hash_here","name":"Websoul Admin","role":"Administrator"}]

# Option 2: Single-admin environment variables (scrypt hash recommended; plaintext supported as fallback)
ADMIN_EMAIL=admin@websoul.tech
ADMIN_PASSWORD_HASH=scrypt:your_salt_here:your_hash_here
ADMIN_NAME=Websoul Admin

# JWT Secret Key (Generate a high-entropy secret, min 32 chars, for signing tokens)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# EmailJS (Client Contact Form)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Cloudinary (Blog Image Uploads)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Firebase Web Client Configuration (Optional overrides)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Analytics 4 (Optional)
VITE_GA_MEASUREMENT_ID=
